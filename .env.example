# OpenSpy RECON Scanner Backend Configuration

# ═══════════════════════════════════════════════════════════════
# SECURITY
# ═══════════════════════════════════════════════════════════════
# Generate a key with: openssl rand -hex 32
OPENSPY_KEY=your-64-character-hex-key-here

# ═══════════════════════════════════════════════════════════════
# SERVER
# ═══════════════════════════════════════════════════════════════
HOST=0.0.0.0
PORT=8000
DEBUG=False

# ═══════════════════════════════════════════════════════════════
# OPTIONAL: EXTERNAL APIS (for enhanced scanning)
# ═══════════════════════════════════════════════════════════════
# AbuseIPDB (get free tier key from https://www.abuseipdb.com)
ABUSEIPDB_KEY=

# Shodan (get key from https://www.shodan.io)
SHODAN_KEY=

# VirusTotal (get key from https://www.virustotal.com)
VIRUSTOTAL_KEY=
